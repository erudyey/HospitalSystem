{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno task check && deno run -A npm:vite build",
    "check": "deno run -A --node-modules-dir=manual npm:svelte-check --tsconfig ./tsconfig.json",
    "test": "deno test src/lib/api.test.ts src/lib/calendar.test.ts",
    "preview": "deno run -A npm:vite preview"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "nodeModulesDir": "auto"
}
